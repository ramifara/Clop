{
  "name": "clop-windows",
  "productName": "Clop for Windows",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "Clipboard image optimisation and floating image tools for Windows",
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/ramifara/Clop.git" },
  "author": "Clop contributors",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "test": "tsx --test --test-timeout=300000 \"core/**/*.test.ts\" \"electron/*.test.ts\" \"cli/*.test.ts\" \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "7z-wasm": "1.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0",
    "resedit": "1.7.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.clop.windows",
    "directories": { "output": "release" },
    "afterPack": "./scripts/after-pack.mjs",
    "files": ["dist/**/*", "dist-electron/**/*", "!dist-electron/cli.mjs", "!dist-electron/clop.exe", "!node_modules/@img/sharp-win32-!(${arch})", "!node_modules/@img/sharp-win32-!(${arch})/**", "package.json"],
    "extraResources": [{ "from": "native", "to": "native", "filter": ["**/*", "!clop.cs", "!installer.nsh"] }, { "from": "dist-electron/cli.mjs", "to": "cli.mjs" }, { "from": "../LICENSE", "to": "LICENSE" }, { "from": "README.md", "to": "README.md" }, { "from": ".tools/win32-${arch}/bin", "to": "bin" }],
    "extraFiles": [{ "from": "dist-electron/clop.exe", "to": "cli/clop.exe" }],
    "asarUnpack": ["node_modules/sharp/**/*", "node_modules/@img/**/*"],
    "electronFuses": { "runAsNode": true, "enableNodeOptionsEnvironmentVariable": false, "enableNodeCliInspectArguments": false, "enableEmbeddedAsarIntegrityValidation": true },
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.ico" },
    "nsis": { "artifactName": "Clop-Windows-${version}-${arch}-Setup.${ext}", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "include": "native/installer.nsh" },
    "portable": { "artifactName": "Clop-Windows-${version}-${arch}-Portable.${ext}" },
    "publish": [{ "provider": "github", "owner": "ramifara", "repo": "Clop", "releaseType": "release" }]
  }
}
